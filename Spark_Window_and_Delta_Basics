# Day-3 with IDC Databricks AI Challenge

### Importing Functions
from pyspark.sql import functions as F
from pyspark.sql.window import Window

### Top 5 Products by Revenue 
events_n = df_n

revenue = events_n.filter(F.col("event_type") == "purchase") \
    .groupBy("product_id") \
    .agg(F.sum("price").alias("revenue")) \
    .orderBy(F.desc("revenue")).limit(5)

display(revenue)

### Running Total per User
window = (
    Window.partitionBy("user_id")
          .orderBy("event_time")
          .rowsBetween(Window.unboundedPreceding, Window.currentRow)
)

result = (
    events_n
    .withColumn("cumulative_events", F.sum(F.lit(1)).over(window))
    .orderBy("user_id", "event_time")
)

display(result)

### Conversion Rate by Category
# Minimal fix: workaround for unsupported 'pivot' in PySpark Connect
from pyspark.sql import functions as F

# Aggregate counts for each event_type per category_code
gb = events_n.groupBy("category_code", "event_type").count()

# Aggregate to get 'view' and 'purchase' counts per category_code
views = gb.filter(F.col("event_type") == "view").select("category_code", F.col("count").alias("view"))
purchases = gb.filter(F.col("event_type") == "purchase").select("category_code", F.col("count").alias("purchase"))

# Join views and purchases
conversion = views.join(purchases, on="category_code", how="left")

# Calculate conversion rate
conversion = conversion.withColumn("conversion_rate", F.col("purchase") / F.col("view") * 100)
conversion.show()


